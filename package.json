{
  "name": "intent-classifier-finetune",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "data:generate": "tsx --env-file-if-exists=.env.local scripts/generate.ts",
    "data:check": "tsx scripts/check-data.ts",
    "train:probe": "tsx scripts/train-probe.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@ai-sdk/google": "^4.0.112",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ai": "^7.0.163",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
